<?xml version='1.0' encoding='UTF-8'?>
<!--
  A hand-made OSM extract, not a download. It exists so tools/seed-osm.sh and
  tools/osm-flex.lua can be exercised where the real extract cannot be fetched:
  every kind the style maps (road, forest, water, footprint), a closed way, an
  open way and a multipolygon relation with a hole, all inside the pilot z10
  tile 10/534/358 near Aarau. The shapes are invented; the real seed is a
  Geofabrik extract, see infra/seed/README.md.
-->
<osm version="0.6" generator="splatworld pilot fixture">
  <!-- footprint: a block with a stated height -->
  <node id="1" version="1" lat="47.3900" lon="8.0400"/>
  <node id="2" version="1" lat="47.3900" lon="8.0405"/>
  <node id="3" version="1" lat="47.3904" lon="8.0405"/>
  <node id="4" version="1" lat="47.3904" lon="8.0400"/>
  <!-- footprint: a house with levels but no height -->
  <node id="5" version="1" lat="47.3910" lon="8.0420"/>
  <node id="6" version="1" lat="47.3910" lon="8.0424"/>
  <node id="7" version="1" lat="47.3913" lon="8.0424"/>
  <node id="8" version="1" lat="47.3913" lon="8.0420"/>
  <!-- water: a pond -->
  <node id="9" version="1" lat="47.3880" lon="8.0360"/>
  <node id="10" version="1" lat="47.3880" lon="8.0380"/>
  <node id="11" version="1" lat="47.3890" lon="8.0380"/>
  <node id="12" version="1" lat="47.3890" lon="8.0360"/>
  <!-- road: a residential street -->
  <node id="13" version="1" lat="47.3895" lon="8.0395"/>
  <node id="14" version="1" lat="47.3898" lon="8.0412"/>
  <node id="15" version="1" lat="47.3906" lon="8.0430"/>
  <!-- road: a secondary road -->
  <node id="16" version="1" lat="47.3870" lon="8.0340"/>
  <node id="17" version="1" lat="47.3920" lon="8.0450"/>
  <!-- forest: outer ring of a multipolygon -->
  <node id="18" version="1" lat="47.3940" lon="8.0300"/>
  <node id="19" version="1" lat="47.3940" lon="8.0360"/>
  <node id="20" version="1" lat="47.3970" lon="8.0360"/>
  <node id="21" version="1" lat="47.3970" lon="8.0300"/>
  <!-- forest: a clearing, the inner ring -->
  <node id="22" version="1" lat="47.3950" lon="8.0320"/>
  <node id="23" version="1" lat="47.3950" lon="8.0335"/>
  <node id="24" version="1" lat="47.3958" lon="8.0335"/>
  <node id="25" version="1" lat="47.3958" lon="8.0320"/>
  <!-- forest: a plain closed way -->
  <node id="26" version="1" lat="47.3820" lon="8.0500"/>
  <node id="27" version="1" lat="47.3820" lon="8.0560"/>
  <node id="28" version="1" lat="47.3850" lon="8.0560"/>
  <node id="29" version="1" lat="47.3850" lon="8.0500"/>

  <way id="100" version="1">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/><nd ref="4"/><nd ref="1"/>
    <tag k="building" v="commercial"/>
    <tag k="height" v="18 m"/>
    <tag k="building:levels" v="5"/>
    <tag k="roof:shape" v="flat"/>
  </way>
  <way id="101" version="1">
    <nd ref="5"/><nd ref="6"/><nd ref="7"/><nd ref="8"/><nd ref="5"/>
    <tag k="building" v="house"/>
    <tag k="building:levels" v="2"/>
    <tag k="roof:shape" v="gabled"/>
  </way>
  <way id="102" version="1">
    <nd ref="9"/><nd ref="10"/><nd ref="11"/><nd ref="12"/><nd ref="9"/>
    <tag k="natural" v="water"/>
    <tag k="water" v="pond"/>
  </way>
  <way id="103" version="1">
    <nd ref="13"/><nd ref="14"/><nd ref="15"/>
    <tag k="highway" v="residential"/>
    <tag k="lanes" v="2"/>
  </way>
  <way id="104" version="1">
    <nd ref="16"/><nd ref="17"/>
    <tag k="highway" v="secondary"/>
    <tag k="width" v="9"/>
  </way>
  <way id="105" version="1">
    <nd ref="18"/><nd ref="19"/><nd ref="20"/><nd ref="21"/><nd ref="18"/>
  </way>
  <way id="106" version="1">
    <nd ref="22"/><nd ref="23"/><nd ref="24"/><nd ref="25"/><nd ref="22"/>
  </way>
  <way id="107" version="1">
    <nd ref="26"/><nd ref="27"/><nd ref="28"/><nd ref="29"/><nd ref="26"/>
    <tag k="natural" v="wood"/>
    <tag k="leaf_type" v="broadleaved"/>
  </way>

  <relation id="200" version="1">
    <member type="way" ref="105" role="outer"/>
    <member type="way" ref="106" role="inner"/>
    <tag k="type" v="multipolygon"/>
    <tag k="landuse" v="forest"/>
    <tag k="leaf_type" v="needleleaved"/>
  </relation>
</osm>
