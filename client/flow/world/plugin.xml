<plugin format="1" id="world">
    <name>World</name>
    <icon type="simicons">file::http</icon>

    <group id="port">
        <name>Port</name>

        <node id="write">
            <name>Write Port</name>
            <description type="short">Set a port on an object in the world</description>
            <description type="long">Writes one port of one placed object — a lamp's
                `on`, a billboard's `image` — as the player the world key belongs
                to. What a port is and what it may be set to is the product's
                (FND.6).</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Object">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Port">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Value">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <output name="OK">
                <structure id="droplet"/>
                <value id="boolean"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>

        <node id="read">
            <name>Read Port</name>
            <description type="short">What a port on an object in the world says</description>
            <description type="long">Reads one port of one placed object. The world
                answers what it last had written, whoever wrote it.</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Object">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Port">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <output name="Value">
                <structure id="droplet"/>
                <value id="string"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>
    </group>

    <group id="mover">
        <name>Mover</name>

        <node id="set">
            <name>Set Mover</name>
            <description type="short">Change a thing that moves by the clock</description>
            <description type="long">Sets a mover's speed, its timetable or whether
                it is paused (FND.16). The route itself is drawn on the land, not
                here.</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Mover">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Fields">
                <structure id="droplet"/>
                <value id="json"/>
            </input>
            <output name="OK">
                <structure id="droplet"/>
                <value id="boolean"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>
    </group>

    <group id="events">
        <name>Events</name>

        <node id="since">
            <name>Events Since</name>
            <description type="short">What has happened in the world since an event</description>
            <description type="long">Everything the world recorded after the event
                whose number is given: a port changed, somebody clicked something,
                somebody arrived or left (FND.15).</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="After">
                <structure id="droplet" default="true">
                    <value id="integer">0</value>
                </structure>
                <value id="integer"/>
            </input>
            <output name="Events">
                <structure id="droplet"/>
                <value id="json"/>
            </output>
            <output name="Last ID">
                <structure id="droplet"/>
                <value id="integer"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>
    </group>

    <group id="clock">
        <name>Clock</name>

        <node id="now">
            <name>World Clock</name>
            <description type="short">The world's own time, in seconds</description>
            <description type="long">Everything that moves by the clock moves by
                this one, so two players standing at the same stop see the same bus
                at the same second (FND.16).</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <output name="Seconds">
                <structure id="droplet"/>
                <value id="real"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>
    </group>

    <group id="money">
        <name>Money</name>

        <node id="balance">
            <name>Balance</name>
            <description type="short">What a wallet the flow holds has in it</description>
            <description type="long">The cash in one wallet this flow holds, as the wallet last said (PLAN-money.md
                M6). Only the holder reads it: the flow, with its own key.</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Wallet">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <output name="Balance">
                <structure id="droplet"/>
                <value id="real"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>

        <node id="pay">
            <name>Pay</name>
            <description type="short">Send cash from the flow's wallet</description>
            <description type="long">Pays a wallet — a player's, by name, or a wallet's id — from a wallet this
                flow holds, with a message. The wallet says whether it could.</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Wallet">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="To">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Amount">
                <structure id="droplet"/>
                <value id="real"/>
            </input>
            <input name="Message">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <output name="OK">
                <structure id="droplet"/>
                <value id="boolean"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>

        <node id="request">
            <name>Request</name>
            <description type="short">Ask a wallet to pay the flow's</description>
            <description type="long">Asks a player's wallet for cash into a wallet this flow holds; the payer
                confirms it in their wallet. A till is this block.</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Wallet">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="From">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Amount">
                <structure id="droplet"/>
                <value id="real"/>
            </input>
            <input name="Message">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <output name="OK">
                <structure id="droplet"/>
                <value id="boolean"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>

        <node id="received">
            <name>Money Received</name>
            <description type="short">What has come into the flow's wallet</description>
            <description type="long">Every payment into a wallet this flow holds: how much, from whom, with what
                message and when. What came in since the last look fires the rest.</description>
            <input name="World">
                <structure id="droplet"/>
                <value id="url"/>
            </input>
            <input name="World Key">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <input name="Wallet">
                <structure id="droplet"/>
                <value id="string"/>
            </input>
            <output name="Payments">
                <structure id="droplet"/>
                <value id="json"/>
            </output>
            <output name="Error">
                <structure id="droplet"/>
                <value id="error-code"/>
            </output>
        </node>
    </group>
</plugin>
