<elx>
    <engine type="flow"/>
    <input name="World"/>
    <input name="World Key"/>
    <input name="Wallet"/>
    <input name="From"/>
    <input name="Amount"/>
    <input name="Message"/>
    <output name="OK"/>
    <output name="Error"/>
    <net name="N000">
        <connection node="World"/>
        <connection node="Where" port="in"/>
    </net>
    <net name="N001">
        <connection node="Where" port="out"/>
        <connection node="Request" port="Request URL"/>
    </net>
    <net name="N002">
        <connection node="World Key"/>
        <connection node="Bearer" port="in"/>
    </net>
    <net name="N003">
        <connection node="Bearer" port="out"/>
        <connection node="Headers" port="value"/>
    </net>
    <net name="N004">
        <connection node="Headers" port="out"/>
        <connection node="Request" port="Request Headers"/>
    </net>
    <net name="N005">
        <connection node="Empty" port="json"/>
        <connection node="With Wallet" port="json"/>
    </net>
    <net name="N006">
        <connection node="Wallet"/>
        <connection node="With Wallet" port="value"/>
    </net>
    <net name="N007">
        <connection node="With Wallet" port="out"/>
        <connection node="With From" port="json"/>
    </net>
    <net name="N008">
        <connection node="From"/>
        <connection node="With From" port="value"/>
    </net>
    <net name="N009">
        <connection node="With From" port="out"/>
        <connection node="With Amount" port="json"/>
    </net>
    <net name="N010">
        <connection node="Amount"/>
        <connection node="With Amount" port="value"/>
    </net>
    <net name="N011">
        <connection node="With Amount" port="out"/>
        <connection node="With Message" port="json"/>
    </net>
    <net name="N012">
        <connection node="Message"/>
        <connection node="With Message" port="value"/>
    </net>
    <net name="N013">
        <connection node="With Message" port="out"/>
        <connection node="Body" port="json"/>
    </net>
    <net name="N014">
        <connection node="Body" port="string"/>
        <connection node="Request" port="Request Body"/>
    </net>
    <net name="N015">
        <connection node="Request" port="Response Status"/>
        <connection node="Took It" port="in 1"/>
    </net>
    <net name="N016">
        <connection node="Took It" port="out"/>
        <connection node="OK"/>
    </net>
    <net name="N017">
        <connection node="Request" port="Error"/>
        <connection node="Error"/>
    </net>
    <node id="append" name="Where" plugin="strings">
        <parameter id="append"><value id="string">/rpc/wallet_request</value></parameter>
    </node>
    <node id="prepend" name="Bearer" plugin="strings">
        <parameter id="prepend"><value id="string">Bearer </value></parameter>
    </node>
    <node id="structures.map.insert-or-assign" name="Headers" plugin="builtin">
        <parameter id="key"><value id="string">Authorization</value></parameter>
    </node>
    <node id="create-empty-object" name="Empty" plugin="json"/>
    <node id="set" name="With Wallet" plugin="json">
        <parameter id="key"><value id="string">w</value></parameter>
    </node>
    <node id="set" name="With From" plugin="json">
        <parameter id="key"><value id="string">from_who</value></parameter>
    </node>
    <node id="set" name="With Amount" plugin="json">
        <parameter id="key"><value id="string">amount</value></parameter>
    </node>
    <node id="set" name="With Message" plugin="json">
        <parameter id="key"><value id="string">message</value></parameter>
    </node>
    <node id="to-string" name="Body" plugin="json"/>
    <node id="client.make-request-simple" name="Request" plugin="http">
        <parameter id="Request Method"><value id="string">POST</value></parameter>
    </node>
    <node id="arithmetic.comparison.less" name="Took It" plugin="mathematics">
        <parameter id="in 2"><value id="integer">300</value></parameter>
    </node>
</elx>
