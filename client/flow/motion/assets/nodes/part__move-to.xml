    </net>
    <node id="create-empty-object" name="Empty" plugin="json"/>
    <node id="set" name="Set X" plugin="json">
        <parameter id="key"><value id="string">x</value></parameter>
    </node>
    <node id="set" name="Set Y" plugin="json">
        <parameter id="key"><value id="string">y</value></parameter>
    </node>
    <node id="set" name="Set Z" plugin="json">
        <parameter id="key"><value id="string">z</value></parameter>
    </node>
    <node id="create-empty-object" name="Outer" plugin="json"/>
    <node id="set" name="With To" plugin="json">
        <parameter id="key"><value id="string">to</value></parameter>
    </node>
    <node id="set" name="With Over" plugin="json">
        <parameter id="key"><value id="string">over_s</value></parameter>
    </node>
    <node id="to-string" name="Body" plugin="json"/>
    <node id="flow-control.if-else" name="Gate" plugin="builtin"/>
    <node id="port.write" name="Write" plugin="world"/>
</elx>
