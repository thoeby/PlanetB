    </net>
    <net name="N012">
        <connection node="When"/>
        <connection node="Gate" port="condition"/>
    </net>
    <net name="N013">
        <connection node="Gate" port="true"/>
        <connection node="Write" port="Value"/>
    </net>
    <net name="N014">
        <connection node="World"/>
        <connection node="Write" port="World"/>
    </net>
    <net name="N015">
        <connection node="World Key"/>
        <connection node="Write" port="World Key"/>
    </net>
    <net name="N016">
        <connection node="Object"/>
        <connection node="Write" port="Object"/>
    </net>
    <net name="N017">
        <connection node="Port"/>
        <connection node="Write" port="Port"/>
    </net>
    <net name="N018">
        <connection node="Write" port="OK"/>
