<elx>
    <engine type="flow"/>
    <input name="World"/>
    <input name="World Key"/>
    <input name="Object"/>
    <input name="Port"/>
    <input name="X"/>
    <input name="Y"/>
    <input name="Z"/>
    <input name="Over"/>
    <input name="When"/>
    <output name="OK"/>
    <output name="Error"/>
    <net name="N000">
        <connection node="Empty" port="json"/>
        <connection node="Set X" port="json"/>
    </net>
    <net name="N001">
        <connection node="X"/>
        <connection node="Set X" port="value"/>
    </net>
    <net name="N002">
        <connection node="Set X" port="out"/>
        <connection node="Set Y" port="json"/>
    </net>
    <net name="N003">
        <connection node="Y"/>
        <connection node="Set Y" port="value"/>
    </net>
    <net name="N004">
        <connection node="Set Y" port="out"/>
        <connection node="Set Z" port="json"/>
    </net>
    <net name="N005">
        <connection node="Z"/>
        <connection node="Set Z" port="value"/>
    </net>
    <net name="N006">
        <connection node="Outer" port="json"/>
        <connection node="With To" port="json"/>
    </net>
    <net name="N007">
        <connection node="Set Z" port="out"/>
        <connection node="With To" port="value"/>
    </net>
    <net name="N008">
        <connection node="With To" port="out"/>
        <connection node="With Over" port="json"/>
    </net>
    <net name="N009">
        <connection node="Over"/>
        <connection node="With Over" port="value"/>
    </net>
    <net name="N010">
        <connection node="With Over" port="out"/>
