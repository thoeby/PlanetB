<elx>
    <engine type="flow"/>
    <input name="World"/>
    <input name="World Key"/>
    <input name="Object"/>
    <input name="Port"/>
    <input name="Route"/>
    <input name="Speed"/>
    <input name="Loop"/>
    <input name="When"/>
    <output name="OK"/>
    <output name="Error"/>
    <net name="N000">
        <connection node="Empty" port="json"/>
        <connection node="Set Route" port="json"/>
    </net>
    <net name="N001">
        <connection node="Route"/>
        <connection node="Set Route" port="value"/>
    </net>
    <net name="N002">
        <connection node="Set Route" port="out"/>
        <connection node="Set Speed" port="json"/>
    </net>
    <net name="N003">
        <connection node="Speed"/>
        <connection node="Set Speed" port="value"/>
    </net>
    <net name="N004">
        <connection node="Set Speed" port="out"/>
        <connection node="Set Loop" port="json"/>
    </net>
    <net name="N005">
        <connection node="Loop"/>
        <connection node="Set Loop" port="value"/>
    </net>
    <net name="N006">
        <connection node="Set Loop" port="out"/>
        <connection node="Body" port="json"/>
    </net>
    <net name="N007">
        <connection node="Body" port="string"/>
        <connection node="Gate" port="in"/>
    </net>
    <net name="N008">
        <connection node="When"/>
        <connection node="Gate" port="condition"/>
    </net>
    <net name="N009">
        <connection node="Gate" port="true"/>
        <connection node="Write" port="Value"/>
    </net>
    <net name="N010">
        <connection node="World"/>
        <connection node="Write" port="World"/>
    </net>
    <net name="N011">
        <connection node="World Key"/>
        <connection node="Write" port="World Key"/>
    </net>
    <net name="N012">
        <connection node="Object"/>
        <connection node="Write" port="Object"/>
    </net>
    <net name="N013">
        <connection node="Port"/>
        <connection node="Write" port="Port"/>
    </net>
    <net name="N014">
        <connection node="Write" port="OK"/>
        <connection node="OK"/>
    </net>
    <net name="N015">
        <connection node="Write" port="Error"/>
        <connection node="Error"/>
    </net>
    <node id="create-empty-object" name="Empty" plugin="json"/>
    <node id="set" name="Set Route" plugin="json">
        <parameter id="key"><value id="string">route_m</value></parameter>
    </node>
    <node id="set" name="Set Speed" plugin="json">
        <parameter id="key"><value id="string">speed</value></parameter>
    </node>
    <node id="set" name="Set Loop" plugin="json">
        <parameter id="key"><value id="string">loop</value></parameter>
    </node>
    <node id="to-string" name="Body" plugin="json"/>
    <node id="flow-control.if-else" name="Gate" plugin="builtin"/>
    <node id="port.write" name="Write" plugin="world"/>
</elx>
