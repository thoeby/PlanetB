<elx>
    <engine type="flow"/>
    <input name="World"/>
    <input name="World Key"/>
    <input name="Object"/>
    <input name="Kind"/>
    <input name="After"/>
    <output name="Fired"/>
    <output name="Events"/>
    <output name="Last ID"/>
    <output name="Error"/>
    <net name="N000">
        <connection node="World"/>
        <connection node="Where" port="in"/>
    </net>
    <net name="N001">
        <connection node="Where" port="out"/>
        <connection node="Request" port="Request URL"/>
    </net>
    <net name="N002">
        <connection node="World Key"/>
        <connection node="Bearer" port="in"/>
    </net>
    <net name="N003">
        <connection node="Bearer" port="out"/>
        <connection node="Headers" port="value"/>
    </net>
    <net name="N004">
        <connection node="Headers" port="out"/>
        <connection node="Request" port="Request Headers"/>
    </net>
    <net name="N005">
        <connection node="Empty" port="json"/>
        <connection node="With Object" port="json"/>
    </net>
    <net name="N006">
        <connection node="Object"/>
        <connection node="With Object" port="value"/>
    </net>
    <net name="N007">
        <connection node="With Object" port="out"/>
        <connection node="With Kind" port="json"/>
    </net>
    <net name="N008">
        <connection node="Kind"/>
        <connection node="With Kind" port="value"/>
    </net>
    <net name="N009">
        <connection node="With Kind" port="out"/>
        <connection node="With After" port="json"/>
    </net>
    <net name="N010">
        <connection node="After"/>
        <connection node="With After" port="value"/>
    </net>
    <net name="N011">
        <connection node="With After" port="out"/>
        <connection node="Body" port="json"/>
    </net>
    <net name="N012">
        <connection node="Body" port="string"/>
        <connection node="Request" port="Request Body"/>
    </net>
    <net name="N013">
        <connection node="Request" port="Response Body"/>
        <connection node="Said" port="string"/>
    </net>
    <net name="N014">
        <connection node="Said" port="json"/>
        <connection node="Read Fired" port="json"/>
    </net>
    <net name="N015">
        <connection node="Read Fired" port="out"/>
        <connection node="Fired"/>
    </net>
    <net name="N016">
        <connection node="Said" port="json"/>
        <connection node="Read Events" port="json"/>
    </net>
    <net name="N017">
        <connection node="Read Events" port="out"/>
        <connection node="Events"/>
    </net>
    <net name="N018">
        <connection node="Said" port="json"/>
        <connection node="Read Last ID" port="json"/>
    </net>
    <net name="N019">
        <connection node="Read Last ID" port="out"/>
        <connection node="Last ID"/>
    </net>
    <net name="N020">
        <connection node="Request" port="Error"/>
        <connection node="Error"/>
    </net>
    <node id="append" name="Where" plugin="strings">
        <parameter id="append"><value id="string">/rpc/triggers_since</value></parameter>
    </node>
    <node id="prepend" name="Bearer" plugin="strings">
        <parameter id="prepend"><value id="string">Bearer </value></parameter>
    </node>
    <node id="structures.map.insert-or-assign" name="Headers" plugin="builtin">
        <parameter id="key"><value id="string">Authorization</value></parameter>
    </node>
    <node id="create-empty-object" name="Empty" plugin="json"/>
    <node id="set" name="With Object" plugin="json">
        <parameter id="key"><value id="string">p_instance</value></parameter>
    </node>
    <node id="set" name="With Kind" plugin="json">
        <parameter id="key"><value id="string">p_kind</value></parameter>
    </node>
    <node id="set" name="With After" plugin="json">
        <parameter id="key"><value id="string">p_after</value></parameter>
    </node>
    <node id="to-string" name="Body" plugin="json"/>
    <node id="client.make-request-simple" name="Request" plugin="http">
        <parameter id="Request Method"><value id="string">POST</value></parameter>
    </node>
    <node id="from-string" name="Said" plugin="json"/>
    <node id="get" name="Read Fired" plugin="json">
        <parameter id="pointer"><value id="string">fired</value></parameter>
    </node>
    <node id="get" name="Read Events" plugin="json">
        <parameter id="pointer"><value id="string">events</value></parameter>
    </node>
    <node id="get" name="Read Last ID" plugin="json">
        <parameter id="pointer"><value id="string">last_id</value></parameter>
    </node>
</elx>
