.env
node_modules/
infra/files/
client/vendor/*/
!client/vendor/README.md
# three.js and the path tracer are what the frame atom runs, not a CDN mirror:
# checked in, so a checkout works without `make vendor` (client/vendor/README.md).
!client/vendor/three/
# brush's wasm is a Rust build (tools/build-brush.sh): checked in for the same reason.
!client/vendor/brush/
docs/*.local.*
*.log
test-results/
playwright-report/
infra/seed/cache/

# tools/backup.sh defaults here, and a backup is the whole world in one place.
backups/

# python build artefacts from server/
server/*.egg-info/
server/build/
__pycache__/
*.pyc
/data
postgrest.exe
infra/seed/dem-visp.tif*
