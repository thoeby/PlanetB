.env
node_modules/
infra/files/
client/vendor/*/
!client/vendor/README.md
# three.js and the path tracer are what the frame atom runs, not a CDN mirror:
# checked in, so a checkout works without `make vendor` (client/vendor/README.md).
!client/vendor/three/
# brush's wasm is a Rust build (tools/build-brush.sh): checked in for the same reason.
!client/vendor/brush/
# litegraph is the flow editor's canvas (TASKS-foundation.md FND.1), pinned to
# one upstream commit and unreachable from some networks: checked in too.
!client/vendor/litegraph/
docs/*.local.*
*.log
test-results/
playwright-report/

# tools/backup.sh defaults here, and a backup is the whole world in one place.
backups/

# python build artefacts from server/
server/*.egg-info/
server/build/
__pycache__/
*.pyc
/data
postgrest.exe
infra/seed/dem-visp.tif*
# The fixtures of TASKS-foundation.md FND.0, cached by their tools like the DEM.
infra/seed/osm-visp.gpkg
infra/seed/tlm-visp.gpkg
infra/seed/worldcover-visp.tif

# Scratch harnesses a session leaves in the working directory.
*.tmp.mjs
