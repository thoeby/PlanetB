[sqlfluff]
dialect = postgres
templater = raw
max_line_length = 90
# sqlfluff has no plpgsql grammar: dollar-quoted function bodies and
# `SET LOCAL <namespace>.<key>` come back as unparsable. Style is enforced on
# everything it can read; the bodies are covered by the pgTAP suite instead.
ignore = parsing
# Rules that fight plpgsql bodies or our deliberate layout choices.
# AL03/CP01/CP02 misfire on this dialect: PostGIS type modifiers and the
# PUBLIC/VALUE keywords are parsed as identifiers, and INSERT..SELECT columns
# do not want aliases.
exclude_rules = AL03, CP01, CP02, LT05, LT09, LT12, ST05, ST06, ST07, AM04, CV02, RF01, RF02, RF03, RF04, CP03, LT02, LT01, LT14, CV08, ST02, ST03, ST09, AL01, AL05, CV03, CV12, LT08, LT04

[sqlfluff:indentation]
indented_joins = false
indented_using_on = true

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper
[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower
[sqlfluff:rules:capitalisation.literals]
capitalisation_policy = lower
