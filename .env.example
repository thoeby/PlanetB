# copy to .env before `make up`
POSTGRES_PASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=splatworld

# HS256 secret shared by db login() and PostgREST. >= 32 chars.
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# PostgREST
PGRST_DB_URI=postgres://authenticator:authenticator@db:5432/splatworld
PGRST_DB_ANON_ROLE=anon
PGRST_DB_SCHEMAS=api
AUTHENTICATOR_PASSWORD=authenticator

# nginx immutable file store
FILES_ROOT=./infra/files
API_INTERNAL=http://postgrest:3000

# GeoServer. It publishes the operator's elevation over WCS and is asked for
# nothing else: QGIS connects to this database as the player (SPEC §2.11).
GEOSERVER_ADMIN_PASSWORD=geoserver

# The process server flows are checked against (TASKS-foundation.md FND.2):
# `make flow-test` POSTs every sample to <ELX_URL>/api/v1/process/validate.
# Empty means "not reachable", and every test that needs it skips with a line
# saying so.
ELX_URL=

# The world's cash (PLAN-money.md): a GNU Taler issuer and the libeufin-bank it
# reads from, started by tools/taler-up.sh (or infra/compose.yml). The currency
# code is fixed once the issuer has signed coins in it.
TALER_CURRENCY=PLANETB
TALER_EXCHANGE_PORT=8091
TALER_BANK_PORT=8092
TALER_ISSUER_PASSWORD=issuer-password
TALER_EXCHANGE_BANK_PASSWORD=exchange-password
