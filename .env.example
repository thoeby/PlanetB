# copy to .env before `make up`
POSTGRES_PASSWORD=postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=splatworld

# HS256 secret shared by db login() and PostgREST. >= 32 chars.
JWT_SECRET=dev-secret-change-me-0123456789abcdef

# PostgREST
PGRST_DB_URI=postgres://authenticator:authenticator@db:5432/splatworld
PGRST_DB_ANON_ROLE=anon
PGRST_DB_SCHEMAS=api
AUTHENTICATOR_PASSWORD=authenticator

# nginx immutable file store
FILES_ROOT=./infra/files
API_INTERNAL=http://postgrest:3000

# GeoServer (admin/visualisation only — never the app API, Invariant 9)
GEOSERVER_ADMIN_PASSWORD=geoserver
# Postgres login GeoServer uses; it has BYPASSRLS, so keep it off the internet.
GEOSERVER_DB_PASSWORD=geoserver
